---
import Navbar from "../components/navbar.astro"
import "../styles/global.css"

// Fonts
import "@fontsource/fusion-pixel-12px-monospaced-jp"
import "@fontsource-variable/raleway"
import Analytics from "../components/analytics.astro"

// SEO Props Interface
interface Props {
    title?: string
    description?: string
    keywords?: string
    image?: string
    url?: string
    type?: string
    author?: string
    publishedTime?: string
}

const {
    title = "Adrian Bonpin - Full Stack Web & Software Developer",
    description = "Building Dreams. One Line at a Time. Custom websites and web applications tailored to your unique vision. No templates, no duplicates, just you.",
    keywords = "web developer, full stack developer, custom websites, web design, web development, adrian bonpin, software developer, freelance developer, bespoke web solutions",
    image = "/og-image.png",
    url = Astro.url.href,
    type = "website",
    author = "Adrian Bonpin",
    publishedTime,
} = Astro.props

const siteName = "Adrian Bonpin"
const siteUrl = Astro.site || "https://adrianbonpin.com"
const canonicalURL = new URL(Astro.url.pathname, siteUrl)
const pagePath = Astro.url.pathname

// Generate breadcrumb items based on pathname
const breadcrumbItems = (() => {
    const parts = pagePath.split("/").filter(Boolean)
    if (parts.length === 0) return []
    const items = [
        { name: "Home", path: "/" },
        ...parts.map((part, i) => ({
            name: part.charAt(0).toUpperCase() + part.slice(1),
            path: "/" + parts.slice(0, i + 1).join("/"),
        })),
    ]
    return items
})()
---

<!doctype html>
<html
    lang='en'
    class='antialiased scroll-smooth scroll-pt-14 overscroll-none'
>
    <head>
        <meta charset='UTF-8' />
        <meta
            name='viewport'
            content='width=device-width, initial-scale=1.0'
        />
        <meta
            name='generator'
            content={Astro.generator}
        />

        <!-- Primary Meta Tags -->
        <title>{title}</title>
        <meta
            name='title'
            content={title}
        />
        <meta
            name='description'
            content={description}
        />
        <meta
            name='keywords'
            content={keywords}
        />
        <meta
            name='author'
            content={author}
        />
        <meta
            name='application-name'
            content={siteName}
        />
        <link
            rel='canonical'
            href={canonicalURL}
        />

        <!-- Browser / Device -->
        <meta
            http-equiv='X-UA-Compatible'
            content='IE=edge'
        />
        <meta
            name='theme-color'
            content='#18122b'
        />
        <meta
            name='color-scheme'
            content='dark'
        />
        <meta
            name='format-detection'
            content='telephone=no'
        />
        <meta
            name='apple-mobile-web-app-capable'
            content='yes'
        />
        <meta
            name='apple-mobile-web-app-status-bar-style'
            content='black-translucent'
        />

        <!-- Open Graph / Facebook -->
        <meta
            property='og:type'
            content={type}
        />
        <meta
            property='og:url'
            content={url}
        />
        <meta
            property='og:title'
            content={title}
        />
        <meta
            property='og:description'
            content={description}
        />
        <meta
            property='og:image'
            content={new URL(image, siteUrl)}
        />
        <meta
            property='og:image:width'
            content='1200'
        />
        <meta
            property='og:image:height'
            content='630'
        />
        <meta
            property='og:site_name'
            content={siteName}
        />
        <meta
            property='og:locale'
            content='en_US'
        />

        <!-- Twitter -->
        <meta
            property='twitter:card'
            content='summary_large_image'
        />
        <meta
            property='twitter:url'
            content={url}
        />
        <meta
            property='twitter:title'
            content={title}
        />
        <meta
            property='twitter:description'
            content={description}
        />
        <meta
            property='twitter:image'
            content={new URL(image, siteUrl)}
        />
        <meta
            property='twitter:site'
            content='@adrianbonpin'
        />
        <meta
            property='twitter:creator'
            content='@adrianbonpin'
        />

        <!-- Favicon -->
        <link
            rel='icon'
            href='/favicon.png'
            type='image/png'
        />
        <link
            rel='apple-touch-icon'
            href='/favicon.png'
        />

        <!-- Hreflang -->
        <link
            rel='alternate'
            href={canonicalURL}
            hreflang='en'
        />
        <link
            rel='alternate'
            href={canonicalURL}
            hreflang='x-default'
        />

        <!-- JSON-LD: Person -->
        <script is:inline
            type='application/ld+json'
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "Person",
                name: "Adrian Bonpin",
                givenName: "Adrian",
                familyName: "Bonpin",
                jobTitle: "Full Stack Developer & Creative Technologist",
                description: description,
                url: siteUrl,
                image: new URL(image, siteUrl),
                email: "adrianbonpin@gmail.com",
                address: {
                    "@type": "PostalAddress",
                    addressCountry: "PH",
                },
                alumniOf: [
                    {
                        "@type": "CollegeOrUniversity",
                        name: "University of San Carlos",
                    },
                    {
                        "@type": "CollegeOrUniversity",
                        name: "Xavier University Ateneo de Cagayan",
                    },
                ],
                sameAs: [
                    "https://github.com/adrianbonpin",
                    "https://linkedin.com/in/adrianbonpin",
                ],
                knowsAbout: [
                    "Web Development",
                    "Next.js",
                    "Astro",
                    "TypeScript",
                    "Tailwind CSS",
                    "React",
                    "Full-Stack Development",
                    "UI/UX Design",
                ],
                knowsLanguage: ["English", "Filipino"],
            })}
        />

        <!-- JSON-LD: WebSite -->
        <script is:inline
            type='application/ld+json'
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "WebSite",
                name: siteName,
                url: siteUrl,
                description: description,
                author: {
                    "@type": "Person",
                    name: author,
                },
                inLanguage: "en",
            })}
        />

        <!-- JSON-LD: BreadcrumbList -->
        {breadcrumbItems.length > 0 && (
            <script is:inline
                type='application/ld+json'
                set:html={JSON.stringify({
                    "@context": "https://schema.org",
                    "@type": "BreadcrumbList",
                    itemListElement: breadcrumbItems.map((item, i) => ({
                        "@type": "ListItem",
                        position: i + 1,
                        name: item.name,
                        item: new URL(item.path, siteUrl).href,
                    })),
                })}
            />
        )}

        <!-- JSON-LD: Published time for pages that provide it -->
        {publishedTime && (
            <script is:inline
                type='application/ld+json'
                set:html={JSON.stringify({
                    "@context": "https://schema.org",
                    "@type": "WebPage",
                    name: title,
                    description: description,
                    url: canonicalURL.href,
                    datePublished: publishedTime,
                    dateModified: new Date().toISOString().split("T")[0],
                })}
            />
        )}

        <!-- Analytics -->
        <script is:inline
            src='https://stat.ranio.xyz/api/script.js'
            data-site-id='4'
            defer
        ></script>
    </head>
    <body
        class='w-dvw h-dvh overflow-y-auto overscroll-none relative bg-background text-text flex flex-col'
    >
        <Navbar />
        <slot />
        <Analytics />
        <footer class='w-full flex justify-center px-4 py-10'>
            <div
                class='w-full max-w-7xl flex flex-col md:flex-row justify-between items-center'
            >
                <small
                    >© {new Date().getFullYear()} Adrian Bonpin. All rights reserved.</small
                >
                <div
                    class='flex flex-row gap-4 [&_a]:hover:underline [&_a]:hover:text-secondary transition-colors'
                >
                    <a
                        href='https://github.com/adrianbonpin'
                        target='_blank'
                        rel='noopener noreferrer'
                        >GitHub</a
                    >
                    <a
                        href='https://linkedin.com/in/adrianbonpin'
                        target='_blank'
                        rel='noopener noreferrer'
                        >LinkedIn</a
                    >
                </div>
            </div>
        </footer>
    </body>
</html>
