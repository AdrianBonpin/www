---
// src/pages/contact.astro
import Base from "../layouts/base.astro"
import SectionHeading from "../components/section-heading.astro"
import ContactForm from "../components/contact-form.astro"
import { siteConfig } from "../data/site-config"
import { MailIcon, GithubIcon, LinkedinIcon } from "@lucide/astro"
---

<Base
  title={`Contact — ${siteConfig.name}`}
  description="Get in touch with Adrian Bonpin — contact form, email, and social links for project inquiries."
>
  <main class="pt-20 pb-10 space-y-12">
    <SectionHeading
      as="h1"
      title="Contact"
      subtitle="Have a project in mind? Let's talk."
    />

    <ContactForm />

    <section class="w-full max-w-2xl mx-auto space-y-4">
      <h2 class="text-lg font-semibold">Other ways to reach me</h2>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href={`mailto:${siteConfig.email}`}
          class="flex flex-row items-center gap-2 px-4 py-3 rounded-lg border border-text/10 bg-text/5 hover:border-primary/50 hover:-translate-y-0.5 transition-all"
        >
          <MailIcon class="w-5 h-5 text-primary" />
          <span>{siteConfig.email}</span>
        </a>
        <a
          href={siteConfig.socials.github}
          target="_blank"
          class="flex flex-row items-center gap-2 px-4 py-3 rounded-lg border border-text/10 bg-text/5 hover:border-primary/50 hover:-translate-y-0.5 transition-all"
        >
          <GithubIcon class="w-5 h-5 text-primary" />
          <span>GitHub</span>
        </a>
        <a
          href={siteConfig.socials.linkedin}
          target="_blank"
          class="flex flex-row items-center gap-2 px-4 py-3 rounded-lg border border-text/10 bg-text/5 hover:border-primary/50 hover:-translate-y-0.5 transition-all"
        >
          <LinkedinIcon class="w-5 h-5 text-primary" />
          <span>LinkedIn</span>
        </a>
      </div>
    </section>
  </main>
</Base>
