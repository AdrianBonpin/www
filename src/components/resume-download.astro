---
// src/components/resume-download.astro
import { DownloadIcon, FileTextIcon } from "@lucide/astro"
---

<div class="w-full max-w-7xl mx-auto px-4 flex flex-wrap gap-3">
  <a
    href="/resume.pdf"
    download
    class="inline-flex flex-row items-center gap-2 px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-secondary transition-colors"
  >
    <DownloadIcon class="w-5 h-5" />
    Download Resume (PDF)
  </a>
  <a
    href="/cv.pdf"
    download
    class="inline-flex flex-row items-center gap-2 px-6 py-3 border border-primary text-primary rounded-lg font-semibold hover:bg-primary/15 transition-colors"
  >
    <FileTextIcon class="w-5 h-5" />
    Download CV (PDF)
  </a>
</div>
