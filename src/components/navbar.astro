---
// src/components/navbar.astro
import { siteConfig } from "../data/site-config"
---

<nav
    class='fixed top-0 z-10 flex justify-center px-4 py-2 w-full bg-background'
>
    <div
        class='w-full flex flex-row gap-2 justify-between items-center max-w-7xl'
    >
        <a
            title='Home'
            href='/'
            class='font-pixel text-3xl font-bold hover:bg-text hover:text-background px-2 transition-colors'
            >ab</a
        >
        <div class='flex flex-row gap-8'>
            {
                siteConfig.navItems.map((item) => (
                    <a
                        href={item.href}
                        class={`font-pixel text-xl relative group`}
                    >
                        {item.label}
                        <div class='absolute bottom-px left-0 right-0 group-hover:bg-secondary bg-transparent h-px transition-colors' />
                    </a>
                ))
            }
        </div>
    </div>
</nav>
