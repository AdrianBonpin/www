---
import { SendIcon, ArrowRightIcon } from "@lucide/astro"
---

<form
  id="contact-form"
  class="w-full max-w-2xl space-y-6"
  novalidate
>
  {/* Honeypot — hidden from humans, visible to bots */}
  <div style="position:absolute;left:-9999px" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  {/* Name + Email row on md+ */}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-5">
    <div class="space-y-2">
      <label for="name" class="block text-[11px] font-pixel text-primary uppercase tracking-widest">
        Name
      </label>
      <input
        type="text"
        id="name"
        name="name"
        required
        minlength="2"
        maxlength="100"
        class="w-full px-4 py-3 rounded-xl bg-transparent border border-text/10 text-text placeholder:text-text/25 focus:outline-none focus:border-primary/60 focus:shadow-[0_0_0_3px_rgba(99,89,133,0.12)] transition-all duration-300"
        placeholder="Your name"
      />
    </div>

    <div class="space-y-2">
      <label for="email" class="block text-[11px] font-pixel text-primary uppercase tracking-widest">
        Email
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        maxlength="254"
        class="w-full px-4 py-3 rounded-xl bg-transparent border border-text/10 text-text placeholder:text-text/25 focus:outline-none focus:border-primary/60 focus:shadow-[0_0_0_3px_rgba(99,89,133,0.12)] transition-all duration-300"
        placeholder="you@example.com"
      />
    </div>
  </div>

  <div class="space-y-2">
    <label for="subject" class="block text-[11px] font-pixel text-primary uppercase tracking-widest">
      Subject
    </label>
    <input
      type="text"
      id="subject"
      name="subject"
      required
      minlength="2"
      maxlength="200"
      class="w-full px-4 py-3 rounded-xl bg-transparent border border-text/10 text-text placeholder:text-text/25 focus:outline-none focus:border-primary/60 focus:shadow-[0_0_0_3px_rgba(99,89,133,0.12)] transition-all duration-300"
      placeholder="What's this about?"
    />
  </div>

  <div class="space-y-2">
    <label for="message" class="block text-[11px] font-pixel text-primary uppercase tracking-widest">
      Message
    </label>
    <textarea
      id="message"
      name="message"
      required
      minlength="10"
      maxlength="5000"
      rows="5"
      class="w-full px-4 py-3 rounded-xl bg-transparent border border-text/10 text-text placeholder:text-text/25 focus:outline-none focus:border-primary/60 focus:shadow-[0_0_0_3px_rgba(99,89,133,0.12)] transition-all duration-300 resize-y"
      placeholder="Tell me about your project, timeline, or anything else..."
    ></textarea>
  </div>

  <div id="form-status" class="hidden text-sm font-pixel"></div>

  <button
    type="submit"
    id="submit-btn"
    class="w-full inline-flex items-center justify-center gap-2.5 px-6 py-3.5 bg-primary/90 backdrop-blur-sm text-white rounded-xl font-semibold hover:bg-secondary transition-all duration-300 group shadow-[0_0_20px_-4px_rgba(99,89,133,0.4)] hover:shadow-[0_0_28px_-2px_rgba(99,89,133,0.6)] hover:-translate-y-0.5 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:translate-y-0 disabled:hover:shadow-none"
  >
    <SendIcon class="w-5 h-5" />
    <span id="submit-text">Send Message</span>
    <ArrowRightIcon class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" />
  </button>
</form>

<script>
  function validateField(el: HTMLInputElement | HTMLTextAreaElement): string | null {
    const val = el.value.trim()
    const name = el.name

    if (el.required && !val) return `${name} is required.`
    if (el.minLength && val.length < el.minLength) return `${name} must be at least ${el.minLength} characters.`
    if (el.maxLength && val.length > el.maxLength) return `${name} must be under ${el.maxLength} characters.`
    if (el.type === "email" && val) {
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
      if (!emailRe.test(val)) return "Please enter a valid email."
    }
    return null
  }

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null
    const status = document.getElementById("form-status") as HTMLElement | null
    const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement | null
    const submitText = document.getElementById("submit-text") as HTMLElement | null

    if (!form || !status || !submitBtn) return

    form.addEventListener("submit", async (e) => {
      e.preventDefault()

      // Validate all fields
      const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]")
      let errors: string[] = []
      fields.forEach((f) => {
        const err = validateField(f)
        if (err) errors.push(err)
      })

      if (errors.length > 0) {
        status.textContent = errors.join(" ")
        status.className = "text-red-400 text-sm font-pixel"
        status.classList.remove("hidden")
        return
      }

      // Submit
      submitBtn.disabled = true
      if (submitText) submitText.textContent = "Sending..."
      status.className = "hidden"

      try {
        const body = new FormData(form)
        const res = await fetch("/api/contact", {
          method: "POST",
          body,
        })

        const data = await res.json() as { ok: boolean; error?: string }

        if (data.ok) {
          status.textContent = "Message sent! I'll get back to you soon."
          status.className = "text-green-400 text-sm font-pixel"
          status.classList.remove("hidden")
          form.reset()
        } else {
          status.textContent = data.error ?? "Something went wrong. Please try again."
          status.className = "text-red-400 text-sm font-pixel"
          status.classList.remove("hidden")
        }
      } catch {
        status.textContent = "Network error. Please try again later."
        status.className = "text-red-400 text-sm font-pixel"
        status.classList.remove("hidden")
      } finally {
        submitBtn.disabled = false
        if (submitText) submitText.textContent = "Send Message"
      }
    })
  })
</script>
