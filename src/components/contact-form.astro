---
// src/components/contact-form.astro
---

<form
  id="contact-form"
  class="w-full max-w-2xl mx-auto space-y-5"
  novalidate
>
  {/* Honeypot — hidden from humans, visible to bots */}
  <div style="position:absolute;left:-9999px" aria-hidden="true">
    <label for="website">Website</label>
    <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <div>
    <label for="name" class="block text-sm font-medium mb-1">Name</label>
    <input
      type="text"
      id="name"
      name="name"
      required
      minlength="2"
      maxlength="100"
      class="w-full px-4 py-3 rounded-lg bg-accent border border-text/10 text-text placeholder:text-text/30 focus:outline-none focus:border-primary transition-colors"
      placeholder="Your name"
    />
  </div>

  <div>
    <label for="email" class="block text-sm font-medium mb-1">Email</label>
    <input
      type="email"
      id="email"
      name="email"
      required
      maxlength="254"
      class="w-full px-4 py-3 rounded-lg bg-accent border border-text/10 text-text placeholder:text-text/30 focus:outline-none focus:border-primary transition-colors"
      placeholder="you@example.com"
    />
  </div>

  <div>
    <label for="subject" class="block text-sm font-medium mb-1">Subject</label>
    <input
      type="text"
      id="subject"
      name="subject"
      required
      minlength="2"
      maxlength="200"
      class="w-full px-4 py-3 rounded-lg bg-accent border border-text/10 text-text placeholder:text-text/30 focus:outline-none focus:border-primary transition-colors"
      placeholder="What's this about?"
    />
  </div>

  <div>
    <label for="message" class="block text-sm font-medium mb-1">Message</label>
    <textarea
      id="message"
      name="message"
      required
      minlength="10"
      maxlength="5000"
      rows="5"
      class="w-full px-4 py-3 rounded-lg bg-accent border border-text/10 text-text placeholder:text-text/30 focus:outline-none focus:border-primary transition-colors resize-y"
      placeholder="Your message..."
    ></textarea>
  </div>

  <div id="form-status" class="hidden text-sm font-pixel"></div>

  <button
    type="submit"
    class="w-full px-6 py-3 bg-primary text-white rounded-lg font-semibold hover:bg-secondary transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
  >
    Send Message
  </button>
</form>

<script>
  function validateField(el: HTMLInputElement | HTMLTextAreaElement): string | null {
    const val = el.value.trim()
    const name = el.name

    if (el.required && !val) return `${name} is required.`
    if (el.minLength && val.length < el.minLength) return `${name} must be at least ${el.minLength} characters.`
    if (el.maxLength && val.length > el.maxLength) return `${name} must be under ${el.maxLength} characters.`
    if (el.type === "email" && val) {
      const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/
      if (!emailRe.test(val)) return "Please enter a valid email."
    }
    return null
  }

  document.addEventListener("DOMContentLoaded", () => {
    const form = document.getElementById("contact-form") as HTMLFormElement | null
    const status = document.getElementById("form-status") as HTMLElement | null
    const submitBtn = form?.querySelector("button[type=submit]") as HTMLButtonElement | null

    if (!form || !status || !submitBtn) return

    form.addEventListener("submit", async (e) => {
      e.preventDefault()

      // Validate all fields
      const fields = form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>("input[required], textarea[required]")
      let errors: string[] = []
      fields.forEach((f) => {
        const err = validateField(f)
        if (err) errors.push(err)
      })

      if (errors.length > 0) {
        status.textContent = errors.join(" ")
        status.className = "text-red-400 text-sm font-pixel"
        status.classList.remove("hidden")
        return
      }

      // Submit
      submitBtn.disabled = true
      submitBtn.textContent = "Sending..."
      status.className = "hidden"

      try {
        const body = new FormData(form)
        const res = await fetch("/api/contact", {
          method: "POST",
          body,
        })

        const data = await res.json() as { ok: boolean; error?: string }

        if (data.ok) {
          status.textContent = "Message sent! I'll get back to you soon."
          status.className = "text-green-400 text-sm font-pixel"
          status.classList.remove("hidden")
          form.reset()
        } else {
          status.textContent = data.error ?? "Something went wrong. Please try again."
          status.className = "text-red-400 text-sm font-pixel"
          status.classList.remove("hidden")
        }
      } catch {
        status.textContent = "Network error. Please try again later."
        status.className = "text-red-400 text-sm font-pixel"
        status.classList.remove("hidden")
      } finally {
        submitBtn.disabled = false
        submitBtn.textContent = "Send Message"
      }
    })
  })
</script>
