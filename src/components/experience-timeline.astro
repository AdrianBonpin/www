---
// src/components/experience-timeline.astro
import type { Experience } from "../data/types"

export interface Props {
  experiences: Experience[]
  compact?: boolean
}

const { experiences, compact = false } = Astro.props
---

<div class="w-full max-w-7xl mx-auto px-4">
  <div class="relative">
    {/* Vertical line */}
    {!compact && (
      <div class="absolute left-3 md:left-6 top-0 bottom-0 w-0.5 bg-primary/30"></div>
    )}

    <div class="flex flex-col gap-6">
      {experiences.map((exp) => (
        <div class={`flex flex-row gap-4 ${compact ? "pb-4 border-b border-text/10" : ""}`}>
          {/* Dot on timeline */}
          {!compact && (
            <div class="relative z-1 mt-1.5 flex-shrink-0">
              <div class="w-3 h-3 md:w-4 md:h-4 rounded-full bg-primary border-2 border-background"></div>
            </div>
          )}

          <div class="flex-1">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-1">
              <h4 class="text-lg md:text-xl font-semibold">{exp.role}</h4>
              <span class="text-sm text-text/50 font-pixel">
                {exp.startDate} — {exp.endDate ?? "Present"}
              </span>
            </div>
            <p class="text-text/70">
              {exp.companyUrl ? (
                <a href={exp.companyUrl} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline">
                  {exp.company}
                </a>
              ) : (
                exp.company
              )}
              {exp.type === "freelance" && (
                <span class="ml-2 text-xs bg-primary/20 text-primary px-2 py-0.5 rounded-full">Freelance</span>
              )}
            </p>
            {!compact && exp.highlights.length > 0 && (
              <ul class="mt-2 space-y-1 list-disc list-inside text-text/80">
                {exp.highlights.map((h) => (
                  <li>{h}</li>
                ))}
              </ul>
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>
