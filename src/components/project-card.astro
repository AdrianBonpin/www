---
// src/components/project-card.astro
import type { Project } from "../data/projects"

export interface Props {
  project: Project
}

const { project } = Astro.props
---

<a
  href={project.link}
  target="_blank"
  rel="noopener noreferrer"
  class="group flex flex-col rounded-xl border border-text/10 bg-text/5 overflow-hidden hover:border-primary/50 hover:-translate-y-1 transition-all duration-300"
>
  <div class="overflow-hidden aspect-video">
    <img
      src={project.img.src}
      alt={project.title}
      loading="lazy"
      class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-300"
    />
  </div>
  <div class="p-4 flex flex-col gap-2 flex-1">
    <div class="flex flex-row items-center justify-between gap-2">
      <h3 class="text-lg font-semibold">{project.title}</h3>
      <span class={`text-xs font-pixel px-2 py-0.5 rounded-full ${
        project.type === "client"
          ? "bg-secondary/30 text-secondary"
          : "bg-primary/20 text-primary"
      }`}>
        {project.type}
      </span>
    </div>
    <p class="text-sm text-text/70 line-clamp-2">{project.desc}</p>
    <div class="flex flex-wrap gap-1.5 mt-auto">
      <span class="text-xs font-pixel px-2 py-0.5 rounded bg-accent/50 text-text/70">{project.framework}</span>
      {project.techTags.filter((tag) => tag !== project.framework).map((tag) => (
        <span class="text-xs px-2 py-0.5 rounded bg-accent/30 text-text/60">{tag}</span>
      ))}
    </div>
    <div class="flex flex-row justify-between items-center mt-2 pt-2 border-t border-text/5">
      <span class="text-xs text-text/50">{project.role}</span>
      <span class="text-xs text-text/40 font-pixel">{project.year}</span>
    </div>
  </div>
</a>
