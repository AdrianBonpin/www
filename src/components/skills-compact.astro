---
// src/components/skills-compact.astro
import { skillCategories } from "../data/skills"
---

<div class="w-full max-w-7xl mx-auto px-4">
  {
    skillCategories.map((cat) => (
      <div class="mb-6">
        <h3 class="text-lg font-semibold mb-2 text-primary">{cat.category}</h3>
        <p class="text-text/80">
          {cat.items.map((s) => s.name).join(" · ")}
        </p>
      </div>
    ))
  }
</div>
